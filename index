<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>NexoHogar Pereira — Servicios para el Hogar</title>
<meta name="description" content="NexoHogar Pereira — Servicios profesionales para el hogar: electricidad, plomería, remodelación y más. Cotiza gratis hoy.">
<meta name="keywords" content="servicios hogar Pereira, electricista Pereira, plomería Pereira, internet campestre Pereira, remodelación hogar">
<meta property="og:title" content="NexoHogar Pereira — Servicios para el Hogar">
<meta property="og:description" content="Servicios profesionales para el hogar en Pereira. Electricidad, plomería, remodelación y más.">
<meta property="og:type" content="website">
<meta property="og:url" content="https://www.nexohogar.com">
<link rel="icon" href="favicon.ico" type="image/x-icon">
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
:root{
  --bg:#080C10;
  --bg2:#0D1117;
  --card:#111820;
  --border:rgba(255,255,255,0.07);
  --accent:#00C9A7;
  --accent2:#0EA5E9;
  --gold:#F59E0B;
  --white:#F0F4F8;
  --muted:rgba(240,244,248,0.45);
  --red:#EF4444;
}
body{font-family:'Inter',sans-serif;background:var(--bg);color:var(--white);overflow-x:hidden;cursor:none}

/* ── CURSOR ── */
.cursor{position:fixed;width:12px;height:12px;background:var(--accent);border-radius:50%;pointer-events:none;z-index:9999;transform:translate(-50%,-50%);transition:transform 0.1s,width 0.3s,height 0.3s;mix-blend-mode:difference}
.cursor-ring{position:fixed;width:36px;height:36px;border:1.5px solid var(--accent);border-radius:50%;pointer-events:none;z-index:9998;transform:translate(-50%,-50%);transition:transform 0.12s,width 0.3s,height 0.3s,opacity 0.3s;opacity:0.5}

/* ── NAV ── */
nav{
  position:fixed;top:0;left:0;right:0;z-index:100;
  display:flex;align-items:center;justify-content:space-between;
  padding:22px 6vw;
  background:rgba(8,12,16,0.8);
  backdrop-filter:blur(24px);
  border-bottom:1px solid var(--border);
}
.logo{font-family:'Syne',sans-serif;font-size:20px;font-weight:800;color:var(--white);text-decoration:none;letter-spacing:-0.5px}
.logo em{color:var(--accent);font-style:normal}
.nav-r{display:flex;align-items:center;gap:36px}
.nav-links{display:flex;gap:28px;list-style:none}
.nav-links a{color:var(--muted);text-decoration:none;font-size:13.5px;font-weight:500;transition:color 0.2s;letter-spacing:0.3px}
.nav-links a:hover{color:var(--white)}
.nav-btn{
  background:var(--accent);color:#000;
  padding:11px 24px;border-radius:8px;
  font-size:13px;font-weight:700;text-decoration:none;
  letter-spacing:0.3px;transition:all 0.25s;
}
.nav-btn:hover{background:#00E5BF;box-shadow:0 0 30px rgba(0,201,167,0.4);transform:translateY(-1px)}

/* ── HERO ── */
.hero{
  min-height:100vh;
  display:grid;grid-template-columns:1fr 1fr;
  align-items:center;
  padding:120px 6vw 80px;
  gap:60px;
  position:relative;overflow:hidden;
}
.hero::before{
  content:'';position:absolute;
  top:-200px;right:-200px;
  width:700px;height:700px;
  background:radial-gradient(circle,rgba(0,201,167,0.12) 0%,transparent 70%);
  pointer-events:none;
}
.hero::after{
  content:'';position:absolute;
  bottom:-100px;left:-100px;
  width:500px;height:500px;
  background:radial-gradient(circle,rgba(14,165,233,0.08) 0%,transparent 70%);
  pointer-events:none;
}
.hero-left{position:relative;z-index:1}
.hero-pill{
  display:inline-flex;align-items:center;gap:8px;
  background:rgba(0,201,167,0.1);
  border:1px solid rgba(0,201,167,0.25);
  color:var(--accent);
  padding:7px 16px;border-radius:100px;
  font-size:12px;font-weight:600;letter-spacing:2px;text-transform:uppercase;
  margin-bottom:32px;
}
.hero-pill span{width:6px;height:6px;border-radius:50%;background:var(--accent);animation:blink 1.5s infinite}
@keyframes blink{0%,100%{opacity:1}50%{opacity:0.3}}
.hero h1{
  font-family:'Syne',sans-serif;
  font-size:clamp(44px,6vw,80px);
  font-weight:800;
  line-height:1.02;
  letter-spacing:-2px;
  margin-bottom:24px;
}
.hero h1 .line2{
  background:linear-gradient(90deg,var(--accent),var(--accent2));
  -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;
}
.hero-desc{
  font-size:17px;color:var(--muted);line-height:1.75;
  max-width:480px;margin-bottom:44px;font-weight:300;
}
.hero-btns{display:flex;gap:14px;flex-wrap:wrap}
.btn-g{
  background:linear-gradient(135deg,var(--accent),var(--accent2));
  color:#000;padding:15px 32px;border-radius:10px;
  font-weight:700;font-size:15px;text-decoration:none;
  transition:all 0.3s;letter-spacing:0.3px;
}
.btn-g:hover{transform:translateY(-3px);box-shadow:0 16px 48px rgba(0,201,167,0.35)}
.btn-out{
  background:transparent;color:var(--white);
  padding:15px 32px;border-radius:10px;
  font-weight:500;font-size:15px;text-decoration:none;
  border:1.5px solid rgba(255,255,255,0.15);transition:all 0.3s;
}
.btn-out:hover{border-color:var(--accent);color:var(--accent)}

.hero-right{position:relative;z-index:1}
.hero-img-main{
  border-radius:24px;overflow:hidden;
  height:580px;position:relative;
  box-shadow:0 40px 100px rgba(0,0,0,0.6);
}
.hero-img-main img{width:100%;height:100%;object-fit:cover}
.hero-img-main::after{
  content:'';position:absolute;inset:0;
  background:linear-gradient(135deg,rgba(0,201,167,0.15),transparent 60%);
  pointer-events:none;
}
.hero-float{
  position:absolute;bottom:-24px;left:-32px;
  background:var(--card);border:1px solid var(--border);
  border-radius:16px;padding:20px 24px;
  backdrop-filter:blur(20px);
  box-shadow:0 20px 60px rgba(0,0,0,0.5);
}
.hero-float-num{
  font-family:'Syne',sans-serif;font-size:42px;font-weight:800;
  background:linear-gradient(90deg,var(--accent),var(--accent2));
  -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;
  line-height:1;margin-bottom:4px;
}
.hero-float-label{font-size:12px;color:var(--muted);font-weight:500}

.hero-float2{
  position:absolute;top:32px;right:-24px;
  background:var(--card);border:1px solid rgba(0,201,167,0.2);
  border-radius:14px;padding:16px 20px;
  box-shadow:0 16px 48px rgba(0,0,0,0.4);
}
.hf2-dot{width:10px;height:10px;border-radius:50%;background:var(--accent);display:inline-block;margin-right:8px;animation:blink 1.5s infinite}
.hf2-text{font-size:13px;font-weight:600}

/* ── MARQUEE ── */
.marquee-wrap{
  border-top:1px solid var(--border);
  border-bottom:1px solid var(--border);
  padding:18px 0;overflow:hidden;
  background:rgba(0,201,167,0.03);
}
.marquee-inner{
  display:flex;gap:64px;
  animation:marquee 22s linear infinite;
  width:max-content;
}
@keyframes marquee{from{transform:translateX(0)}to{transform:translateX(-50%)}}
.marquee-item{
  display:flex;align-items:center;gap:12px;
  font-family:'Syne',sans-serif;font-size:14px;font-weight:600;
  color:var(--muted);letter-spacing:1px;text-transform:uppercase;white-space:nowrap;
}
.marquee-item em{color:var(--accent);font-style:normal;font-size:18px}

/* ── SERVICIOS ── */
#servicios{padding:120px 6vw}
.s-header{display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:64px;gap:40px;flex-wrap:wrap}
.eyebrow{font-size:11px;font-weight:700;letter-spacing:3px;text-transform:uppercase;color:var(--accent);margin-bottom:12px}
.s-title{font-family:'Syne',sans-serif;font-size:clamp(28px,4vw,50px);font-weight:800;line-height:1.1;letter-spacing:-1px}
.s-desc{color:var(--muted);font-size:16px;line-height:1.7;max-width:380px;font-weight:300;margin-top:12px}

/* Cards BENTO */
.bento{display:grid;grid-template-columns:repeat(12,1fr);grid-template-rows:auto;gap:18px}

.bcard{
  background:var(--card);
  border:1px solid var(--border);
  border-radius:20px;
  overflow:hidden;
  position:relative;
  transition:all 0.4s cubic-bezier(0.23,1,0.32,1);
}
.bcard:hover{
  border-color:rgba(0,201,167,0.3);
  transform:translateY(-6px);
  box-shadow:0 24px 80px rgba(0,0,0,0.4);
}
.bcard:hover .bcard-img img{transform:scale(1.08)}
.bcard:hover .bcard-detail{opacity:1;transform:translateY(0)}
.bcard:hover .bc-tag{background:rgba(0,201,167,0.2);color:var(--accent)}

/* Tamaños bento */
.bc1{grid-column:span 5;grid-row:span 2}
.bc2{grid-column:span 4;grid-row:span 1}
.bc3{grid-column:span 3;grid-row:span 1}
.bc4{grid-column:span 4;grid-row:span 1}
.bc5{grid-column:span 3;grid-row:span 1}
.bc6{grid-column:span 5;grid-row:span 1}
.bc7{grid-column:span 7;grid-row:span 1}

.bcard-img{height:100%;min-height:240px;position:relative}
.bcard-img img{width:100%;height:100%;object-fit:cover;transition:transform 0.6s cubic-bezier(0.23,1,0.32,1)}
.bcard-img::after{
  content:'';position:absolute;inset:0;
  background:linear-gradient(to top,rgba(8,12,16,0.97) 0%,rgba(8,12,16,0.4) 50%,rgba(8,12,16,0.1) 100%);
}
.bcard-content{
  position:absolute;bottom:0;left:0;right:0;
  padding:28px;z-index:2;
}
.bc-tag{
  display:inline-block;
  background:rgba(255,255,255,0.08);
  color:rgba(255,255,255,0.55);
  padding:5px 12px;border-radius:100px;
  font-size:11px;font-weight:600;letter-spacing:1.5px;text-transform:uppercase;
  margin-bottom:10px;transition:all 0.3s;
}
.bc-title{font-family:'Syne',sans-serif;font-size:20px;font-weight:700;margin-bottom:6px;letter-spacing:-0.3px}
.bc1 .bc-title{font-size:26px}
.bcard-detail{
  font-size:13.5px;color:var(--muted);line-height:1.6;
  margin-top:10px;opacity:0;transform:translateY(8px);transition:all 0.35s 0.05s;
}
.bc-arrow{
  display:inline-flex;align-items:center;gap:6px;
  color:var(--accent);font-size:13px;font-weight:600;
  margin-top:14px;text-decoration:none;opacity:0;transform:translateY(8px);
  transition:all 0.35s 0.1s;
}
.bcard:hover .bc-arrow{opacity:1;transform:translateY(0)}

/* ── CIFRAS ── */
#cifras{
  padding:100px 6vw;
  background:linear-gradient(135deg,rgba(0,201,167,0.05) 0%,rgba(14,165,233,0.05) 100%);
  border-top:1px solid var(--border);border-bottom:1px solid var(--border);
}
.cifras-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:40px}
.cifra-item{text-align:center}
.cifra-num{
  font-family:'Syne',sans-serif;font-size:clamp(48px,5vw,72px);font-weight:800;
  background:linear-gradient(135deg,var(--accent),var(--accent2));
  -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;
  line-height:1;margin-bottom:8px;
}
.cifra-label{font-size:14px;color:var(--muted);font-weight:400;letter-spacing:0.5px}

/* ── PORQUE ── */
#porque{padding:120px 6vw;display:grid;grid-template-columns:1fr 1fr;gap:80px;align-items:center}
.pq-img{position:relative;border-radius:24px;overflow:hidden;height:600px}
.pq-img img{width:100%;height:100%;object-fit:cover}
.pq-img::after{content:'';position:absolute;inset:0;background:linear-gradient(135deg,rgba(0,201,167,0.2),transparent)}
.pq-chip{
  position:absolute;bottom:28px;left:28px;
  background:rgba(8,12,16,0.9);
  border:1px solid rgba(0,201,167,0.3);
  backdrop-filter:blur(20px);
  padding:18px 24px;border-radius:14px;
}
.pq-chip-n{font-family:'Syne',sans-serif;font-size:38px;font-weight:800;color:var(--accent);line-height:1}
.pq-chip-l{font-size:12px;color:var(--muted);margin-top:2px}

.features{display:flex;flex-direction:column;gap:20px;margin-top:48px}
.feat{
  display:flex;gap:18px;align-items:flex-start;
  background:var(--card);border:1px solid var(--border);
  border-radius:14px;padding:20px;
  transition:all 0.3s;
}
.feat:hover{border-color:rgba(0,201,167,0.25);transform:translateX(6px)}
.feat-icon{
  width:42px;height:42px;min-width:42px;border-radius:10px;
  background:rgba(0,201,167,0.12);
  display:flex;align-items:center;justify-content:center;font-size:20px;
}
.feat h4{font-size:15px;font-weight:600;margin-bottom:4px}
.feat p{font-size:13px;color:var(--muted);line-height:1.55}

/* ── PROCESO ── */
#proceso{
  padding:120px 6vw;
  background:var(--bg2);
}
.proc-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:24px;margin-top:64px}
.proc-step{
  background:var(--card);border:1px solid var(--border);
  border-radius:18px;padding:32px;
  position:relative;overflow:hidden;
  transition:all 0.35s;
}
.proc-step:hover{border-color:rgba(0,201,167,0.3);transform:translateY(-4px)}
.proc-step::before{
  content:'';position:absolute;top:-60px;right:-60px;
  width:160px;height:160px;
  background:radial-gradient(circle,rgba(0,201,167,0.08),transparent 70%);
}
.proc-n{
  font-family:'Syne',sans-serif;font-size:52px;font-weight:800;
  background:linear-gradient(135deg,var(--accent),var(--accent2));
  -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;
  line-height:1;margin-bottom:20px;opacity:0.7;
}
.proc-step h3{font-family:'Syne',sans-serif;font-size:18px;font-weight:700;margin-bottom:8px}
.proc-step p{font-size:13.5px;color:var(--muted);line-height:1.6}

/* ── TESTIMONIOS ── */
#testimonios{padding:120px 6vw}
.test-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:64px}
.tcard{
  background:var(--card);border:1px solid var(--border);
  border-radius:18px;padding:32px;
  transition:all 0.3s;position:relative;overflow:hidden;
}
.tcard::before{
  content:'❝';position:absolute;top:16px;right:20px;
  font-size:64px;color:rgba(0,201,167,0.07);font-family:serif;
  line-height:1;
}
.tcard:hover{border-color:rgba(0,201,167,0.2);transform:translateY(-4px);box-shadow:0 20px 60px rgba(0,0,0,0.3)}
.t-stars{color:var(--gold);font-size:15px;letter-spacing:3px;margin-bottom:18px}
.t-text{font-size:14.5px;color:rgba(240,244,248,0.7);line-height:1.75;font-style:italic;margin-bottom:24px}
.t-author{display:flex;align-items:center;gap:12px}
.t-av{
  width:42px;height:42px;border-radius:50%;
  background:linear-gradient(135deg,var(--accent),var(--accent2));
  display:flex;align-items:center;justify-content:center;
  font-weight:700;font-size:14px;color:#000;
}
.t-name{font-weight:600;font-size:14px}
.t-loc{font-size:11px;color:var(--muted);margin-top:1px}

/* ── CTA ── */
#contacto{
  margin:0 6vw 80px;
  border-radius:28px;
  padding:80px 8vw;
  background:linear-gradient(135deg,#0A1628 0%,#0D2040 50%,#0A1628 100%);
  border:1px solid rgba(0,201,167,0.15);
  position:relative;overflow:hidden;text-align:center;
}
#contacto::before{
  content:'';position:absolute;top:-50%;left:-50%;
  width:200%;height:200%;
  background:radial-gradient(ellipse at center,rgba(0,201,167,0.06) 0%,transparent 60%);
  pointer-events:none;
}
.cta-title{font-family:'Syne',sans-serif;font-size:clamp(36px,5vw,64px);font-weight:800;letter-spacing:-1.5px;margin-bottom:16px}
.cta-title span{background:linear-gradient(90deg,var(--accent),var(--accent2));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.cta-desc{font-size:16px;color:var(--muted);margin-bottom:52px;font-weight:300;line-height:1.7}
.cta-cards{display:flex;justify-content:center;gap:16px;flex-wrap:wrap}
.cta-card{
  background:rgba(255,255,255,0.05);
  border:1px solid rgba(255,255,255,0.1);
  border-radius:14px;padding:24px 32px;
  text-decoration:none;color:var(--white);
  transition:all 0.3s;min-width:180px;
}
.cta-card:hover{background:rgba(0,201,167,0.12);border-color:var(--accent);transform:translateY(-4px);box-shadow:0 16px 48px rgba(0,201,167,0.15)}
.cta-card-ico{font-size:26px;margin-bottom:8px}
.cta-card-lbl{font-size:10px;letter-spacing:2px;text-transform:uppercase;color:var(--accent);margin-bottom:4px;font-weight:600}
.cta-card-val{font-size:16px;font-weight:600}

/* ── FOOTER ── */
footer{
  border-top:1px solid var(--border);
  padding:32px 6vw;
  display:flex;align-items:center;justify-content:space-between;
  flex-wrap:wrap;gap:16px;
}
.footer-logo{font-family:'Syne',sans-serif;font-size:18px;font-weight:800}
.footer-logo em{color:var(--accent);font-style:normal}
.footer-txt{font-size:12px;color:var(--muted)}

/* ── WA FLOAT ── */
.wa{
  position:fixed;bottom:28px;right:28px;z-index:999;
  width:58px;height:58px;border-radius:50%;
  background:#25D366;display:flex;align-items:center;justify-content:center;
  font-size:26px;text-decoration:none;
  box-shadow:0 8px 32px rgba(37,211,102,0.5);
  transition:all 0.3s;
}
.wa:hover{transform:scale(1.12);box-shadow:0 12px 48px rgba(37,211,102,0.7)}

/* ── RESPONSIVE ── */
@media(max-width:1024px){
  .hero{grid-template-columns:1fr;padding-top:100px}
  .hero-right{display:none}
  .bento{grid-template-columns:1fr 1fr}
  .bc1,.bc2,.bc3,.bc4,.bc5,.bc6,.bc7{grid-column:span 1}
  #porque{grid-template-columns:1fr}
  .pq-img{height:400px}
  .cifras-grid{grid-template-columns:repeat(2,1fr)}
  .proc-grid{grid-template-columns:repeat(2,1fr)}
  .test-grid{grid-template-columns:1fr}
  .nav-links{display:none}
}
</style>
</head>
<body>

<div class="cursor" id="cur"></div>
<div class="cursor-ring" id="ring"></div>

<!-- NAV -->
<nav>
  <a href="#" class="logo">NexoHogar<em>.</em></a>
  <div class="nav-r">
    <ul class="nav-links">
      <li><a href="#servicios">Servicios</a></li>
      <li><a href="#porque">Nosotros</a></li>
      <li><a href="#proceso">Proceso</a></li>
    </ul>
    <a href="#contacto" class="nav-btn">Cotizar →</a>
  </div>
</nav>

<!-- HERO -->
<section class="hero">
