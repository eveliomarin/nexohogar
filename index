    <div class="hero-pill"><span></span>Pereira · Risaralda</div>
    <h1>
      Tu hogar,<br>
      <span class="line2">sin límites.</span>
    </h1>
    <p class="hero-desc">Instalación, mantenimiento y automatización para condominios campestres y casas de alto estándar. Profesionales certificados, respuesta en 24 horas.</p>
    <div class="hero-btns">
      <a href="#servicios" class="btn-g">Ver servicios</a>
      <a href="#contacto" class="btn-out">Cotización gratis</a>
    </div>
  </div>
  <div class="hero-right">
    <div class="hero-img-main">
      <img src="images/img-01.png" alt="Casa campestre Pereira">
    </div>
    <div class="hero-float">
      <div class="hero-float-num">+200</div>
      <div class="hero-float-label">Clientes satisfechos</div>
    </div>
    <div class="hero-float2">
      <span class="hf2-dot"></span>
      <span class="hf2-text">Disponible hoy</span>
    </div>
  </div>
</section>

<!-- MARQUEE -->
<div class="marquee-wrap">
  <div class="marquee-inner">
    <div class="marquee-item"><em>❄</em> Aires Acondicionados</div>
    <div class="marquee-item"><em>⚡</em> Redes Eléctricas</div>
    <div class="marquee-item"><em>💧</em> Tanques Hidroflow</div>
    <div class="marquee-item"><em>🔒</em> Seguridad Electrónica</div>
    <div class="marquee-item"><em>🚪</em> Automatización</div>
    <div class="marquee-item"><em>🔧</em> Reparaciones</div>
